# Copie este arquivo para .env e preencha os valores reais:
#   cp .env.example .env
#
# O .env nunca deve ser commitado (já está no .gitignore) nem
# compartilhado publicamente — ele contém credenciais reais do ambiente.

# --- PostgreSQL ------------------------------------------------------------
# Senha do usuário "agencia" (bancos "agencia" e "n8n" no mesmo Postgres).
# Gere um valor aleatório forte, ex.: openssl rand -hex 24
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# --- n8n ---------------------------------------------------------------
# Usada pelo n8n para criptografar credenciais salvas. Gere com:
#   openssl rand -hex 32
# Depois de gerada, NUNCA troque em um ambiente com credenciais já
# salvas no n8n — elas ficam ilegíveis sem a chave original (seção 19 de
# docs/BACKUP_RESTORE.md).
N8N_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria

# --- Backend / autenticação ----------------------------------------------
# Assina os JWTs de sessão. Gere com: openssl rand -hex 48
JWT_SECRET=troque-por-um-segredo-aleatorio-longo
JWT_EXPIRES_IN=8h

# --- Usuário inicial (seed) ------------------------------------------------
# Criado por `db:seed` na primeira execução — vira o usuário CEO com todas
# as permissões. Troque a senha depois do primeiro login.
CEO_NAME=Nome Completo
CEO_EMAIL=voce@suaempresa.com
CEO_PASSWORD=troque-por-uma-senha-forte-com-12-mais-caracteres

# --- Frontend ---------------------------------------------------------
# URL do backend usada pelo servidor Next.js (Route Handlers/Server
# Components) — o navegador nunca acessa essa URL diretamente. Dentro do
# docker-compose, "backend" é o nome do serviço na rede agencia-network.
NEXT_PUBLIC_API_URL=http://backend:8000

# Flag Secure do cookie de sessão. Padrão "true" (exige HTTPS, como deve
# ser em produção real — ver docs/INFRASTRUCTURE.md §33/34 sobre o Nginx
# com TLS ainda não implantado). Só defina "false" enquanto o acesso for
# HTTP puro nesse ambiente; um cookie Secure é descartado pelo navegador em
# origem não-HTTPS, o que impede a sessão de persistir após o login.
# COOKIE_SECURE=true

# --- Agentes v1.1 — LLM Interpreter + Shadow Mode (opcional) ---------------
# Tudo abaixo tem default seguro (AGENT_LLM_ENABLED=false) em
# backend/src/config/env.ts e docker-compose.yml — o sistema funciona
# normalmente sem nenhuma dessas variáveis. Só preencha para ativar o
# LLM Interpreter em modo shadow (mede, nunca decide a resposta — ver
# correio.md seção 10/12) ou fallback (seção 14, ativação manual e
# deliberada, nunca automática).
AGENT_LLM_ENABLED=false
AGENT_LLM_SHADOW_MODE=true
# gemini | openai
AGENT_LLM_PROVIDER=gemini
AGENT_LLM_MODEL=gemini-2.0-flash
AGENT_LLM_TIMEOUT_MS=5000
AGENT_LLM_MIN_CONFIDENCE=0.80
AGENT_LLM_CONTEXT_MESSAGES=10

# Preencha só a key do provider escolhido em AGENT_LLM_PROVIDER — cada
# provider lê só a sua (backend/src/agents/llm/factory.ts). Nunca
# versionar nenhuma das duas.
# AGENT_LLM_API_KEY=          # usada quando AGENT_LLM_PROVIDER=gemini
# OPENAI_API_KEY=             # usada quando AGENT_LLM_PROVIDER=openai

# --- Agentes v2.5.1/v3.1 — Operational Supervision scheduler (opcional) ---
# Default seguro (AGENT_OPERATIONAL_SUPERVISION_ENABLED=false) em
# backend/src/config/env.ts e docker-compose.yml — liga só o TIMER; a
# supervisão só roda de fato se o switch persistido também estiver
# habilitado (PATCH /agents/operations/scheduler, agents.operations.manage).
# Intervalo mínimo aceito: 60 segundos.
AGENT_OPERATIONAL_SUPERVISION_ENABLED=false
AGENT_OPERATIONAL_SUPERVISION_INTERVAL_SECONDS=300
